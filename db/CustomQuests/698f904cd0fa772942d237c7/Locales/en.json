    // =========================
    // PRESSURE RELIEF
    // =========================
    "684edc10a8af5086d3e6557b name": "Pressure Relief",
    "684edc10a8af5086d3e6557b description": "Distance makes people comfortable. It gives them time to think, time to hesitate, time to believe they’re in control. Factory removes that illusion. No distance, no time, no space for mistakes. Just noise, steel, and decisions that happen whether you’re ready or not. I want to see what you are when hesitation isn’t an option.",
    "684edc10a8af5086d3e6557b startedMessageText": "Factory will show me what you really are.",
    "684edc10a8af5086d3e6557b successMessageText": "You didn’t freeze. That’s rare.",
    "684edc10a8af5086d3e6557b completePlayerMessage": "Targets eliminated.",
    "684edc10a8af5086d3e6557b note": "Eliminate PMCs in Factory.",

    "c7e41d533917d1ec03dc460e": "Eliminate 10 PMCs on Factory",

    // =========================
    // ECHO TRAPS
    // =========================
    "68498dcea603d454abc11356 name": "Echo Traps",
    "68498dcea603d454abc11356 description": "I listen more than I speak. Tarkov is full of signals — military channels, private networks, scav chatter. Most people don’t realize how much is being heard, or by who. Right now, too many conversations are happening without me. That changes. You’re going to place disruptors in key locations and leave quietly. When those signals disappear, people start making mistakes.",
    "68498dcea603d454abc11356 startedMessageText": "Place the beacons and stay quiet.",
    "68498dcea603d454abc11356 successMessageText": "Good. Silence is useful.",
    "68498dcea603d454abc11356 completePlayerMessage": "Beacons placed.",
    "68498dcea603d454abc11356 note": "Place signal beacons and extract.",

    "5eca9553f3a992fe7186ffe8": "Place signal beacon at first location",
    "15981ab8ec8aa954a205a4fc": "Place signal beacon at second location",
    "603e1e94b031722bf688626d": "Place signal beacon at third location",
    "500ee99122dbc04cf35d873e": "Extract from raid",

    // =========================
    // FAMILY DEBTS
    // =========================
    "69d81cd30ffb6f16a7c38e69 name": "Family Debts",
    "69d81cd30ffb6f16a7c38e69 description": "Before Tarkov collapsed, I had agreements. Favors, access, protection. When everything fell apart, some people decided those agreements no longer applied. They kept what they owed and disappeared. That was a mistake. I don’t forget debts. I collect them.",
    "69d81cd30ffb6f16a7c38e69 startedMessageText": "Collect what is mine.",
    "69d81cd30ffb6f16a7c38e69 successMessageText": "People remember quickly when pressure is applied.",
    "69d81cd30ffb6f16a7c38e69 completePlayerMessage": "Assets recovered.",
    "69d81cd30ffb6f16a7c38e69 note": "Recover assets and eliminate resistance.",

    "06256be729d22045ac741370": "Eliminate 10 Scavs on Customs",
    "c2ed95c197979810dd2af094": "Find the secured case in raid",
    "e8f66e0884d4751636f4ab6f": "Hand over the secured case",

    // =========================
    // SILENT COURIERS
    // =========================
    "69d81ce56cd2ce07a50d79d2 name": "Silent Couriers",
    "69d81ce56cd2ce07a50d79d2 description": "Goods don’t stop moving. They just move differently. Skier watches the surface. I work underneath it. There are routes in Tarkov that don’t exist unless you already know them. I’m rebuilding those routes. Quietly.",
    "69d81ce56cd2ce07a50d79d2 startedMessageText": "Place the packages. Leave no trace.",
    "69d81ce56cd2ce07a50d79d2 successMessageText": "Routes are active again.",
    "69d81ce56cd2ce07a50d79d2 completePlayerMessage": "Packages placed.",
    "69d81ce56cd2ce07a50d79d2 note": "Plant smuggling packages and extract.",


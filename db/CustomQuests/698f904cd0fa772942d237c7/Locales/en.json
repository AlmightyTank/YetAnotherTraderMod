{
    // ACT 1 Selection

    "699a84bf8e2052342f79b912 name": "Power Supply Run",
    "699a84bf8e2052342f79b912 description": "Power decides what keeps running.\n\nNot generators. Components.\n\nRight now, those components are moving through routes that don’t belong to me.\n\nYou’re going to correct that.\n\nRecover working parts. Not scrap.\n\nOld Sawmill. Weather station.\n\nYou place them. You leave.\n\nSomeone else handles the rest.",
    "699a84bf8e2052342f79b912 startedMessageText": "Find the components. Place them where I told you. Don’t get seen.",
    "699a84bf8e2052342f79b912 successMessageText": "Good. The route is active now.",
    "699a84bf8e2052342f79b912 completePlayerMessage": "Everything is staged. No interruptions.",
    "699a84bf8e2052342f79b912 declinePlayerMessage": "",
    "699a84bf8e2052342f79b912 failMessageText": "",

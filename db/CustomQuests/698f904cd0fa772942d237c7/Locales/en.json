    // =========================
    // OLD ACCOUNTS
    // =========================
    "69d81cf3caf46e08a1002df2 name": "Old Accounts",
    "69d81cf3caf46e08a1002df2 description": "Money doesn’t disappear. It leaves traces. Some of those traces lead back to me. Others lead to people who think I’ve been forgotten. They’re wrong. Bring me the data.",
    "69d81cf3caf46e08a1002df2 startedMessageText": "Find the drives. Bring them intact.",
    "69d81cf3caf46e08a1002df2 successMessageText": "Good. Information stays with me.",
    "69d81cf3caf46e08a1002df2 completePlayerMessage": "Data secured.",
    "69d81cf3caf46e08a1002df2 note": "Recover financial records.",

    "80d9fe503cbd9866053f7eb2": "Find financial drives in raid",
    "b961749deb014e3407999cbb": "Hand over financial drives",

    // =========================
    // THE SHIPMENT
    // =========================
    "69d81cfdc17c3b97d031ff08 name": "The Shipment",
    "69d81cfdc17c3b97d031ff08 description": "I have a shipment moving through Tarkov that isn’t supposed to exist. That makes it valuable. Prapor’s people are watching. That makes it dangerous. Stay with it. If it disappears, so do you.",
    "69d81cfdc17c3b97d031ff08 startedMessageText": "Stay with the shipment.",
    "69d81cfdc17c3b97d031ff08 successMessageText": "Delivered clean.",
    "69d81cfdc17c3b97d031ff08 completePlayerMessage": "Shipment secured.",
    "69d81cfdc17c3b97d031ff08 note": "Secure shipment and extract.",


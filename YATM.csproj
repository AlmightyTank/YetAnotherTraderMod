<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>YetAnotherTraderMod</RootNamespace>
    <AssemblyName>YetAnotherTraderMod</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <Version>6.4.0</Version>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <DefaultItemExcludes>$(DefaultItemExcludes);dist\**;Inspector\**</DefaultItemExcludes>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SPTarkov.Common" Version="4.0.11" />
    <PackageReference Include="SPTarkov.DI" Version="4.0.11" />
    <PackageReference Include="SPTarkov.Server.Core" Version="4.0.11" />
	<PackageReference Include="WTT-ServerCommonLib" Version="2.0.15" />
  </ItemGroup>
  <ItemGroup>
    <None Include="db\**">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="config\**" Exclude="config\**\*.cs">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <Content Remove="db\customcrafts\Copied-Ledger-Drive_Craft.json" />
    <Content Remove="db\CustomCrafts\Logistics-Manifest-Drive_Craft.json" />
    <Content Remove="db\CustomItems\CarbonCasev2.json" />
    <Content Remove="db\CustomItems\Copied-Ledger-Drive.json" />
    <Content Remove="db\CustomItems\ListeningDevice.json" />
    <Content Remove="db\CustomItems\Logistics-Manifest-Drive.json" />
    <Content Remove="db\CustomItems\RoutingRecords.json" />
    <Content Remove="db\CustomItems\Sealed-Box.json" />
    <Content Remove="db\CustomItems\Tracker.json" />
    <Content Remove="db\CustomLootspawns\CustomSpawnpointsForced\customs_spawns.json" />
    <Content Remove="db\customquests\54cb50c76803fa8b248b4571\locales\en.json" />
    <Content Remove="db\customquests\54cb50c76803fa8b248b4571\quests\quest_definitions.json" />
    <Content Remove="db\CustomQuestZones\echoTraps.json" />
    <None Include="package.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CommonLibExtended\CommonLibExtended.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="db\CustomQuests\54cb50c76803fa8b248b4571\Images\" />
    <Folder Include="db\CustomQuests\54cb50c76803fa8b248b4571\Locales\" />
    <Folder Include="db\CustomQuests\54cb50c76803fa8b248b4571\Quests\" />
    <Folder Include="db\CustomQuests\54cb50c76803fa8b248b4571\QuestAssort\" />
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="Build">
    <Exec Command="&quot;$(ProjectDir)build\deploy.cmd&quot; $(AssemblyName) &quot;$(TargetDir)&quot; &quot;$(ProjectDir)&quot;" />
  </Target>
</Project>
